{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "your-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Your Provider",
      "options": {
        "baseURL": "https://your-api-endpoint/v1",
        "apiKey": "{file:.your-token}"
      },
      "models": {
        "your-model": {
          "name": "Your Model",
          "limit": {
            "context": 32000,
            "output": 8000
          }
        }
      }
    }
  },
  "model": "your-provider/your-model",
  "small_model": "your-provider/your-model",
  "experimental": {
    "openTelemetry": true
  }
}
