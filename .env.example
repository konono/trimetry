# Trimetry 環境変数
# cp .env.example .env して値を設定してください

# === Langfuse (provider: langfuse) ===
LANGFUSE_BASEURL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# === MLflow (provider: mlflow) ===
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_TOKEN=          # 認証トークン (任意)
# MLFLOW_TRACKING_WORKSPACE=      # ワークスペース名 (RHOAI 用、任意)

# === Enrichment ===
# TRIMETRY_ENRICHMENT_DIR=/tmp/trimetry-enrichment  # enrichment ファイルの読み取りディレクトリ

# === opencode MLflow プラグイン ===
# MLFLOW_EXPERIMENT_ID=0          # opencode プラグインがトレースを送信する experiment
# MLFLOW_OPENCODE_DEBUG=true      # デバッグ出力を有効化
